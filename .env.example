# Configuración de Base de Datos PostgreSQL
# Si usas Neon, define DATABASE_URL en lugar de DB_HOST/DB_PORT/etc.
# DATABASE_URL=postgres://user:password@host:port/database?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dealradar
DB_USER=postgres
DB_PASSWORD=your_password_here

# Puerto del Backend
PORT=5000

# URL del Frontend (para CORS)
FRONTEND_URL=http://localhost:3000

# Contraseña para proteger las rutas admin
ADMIN_PASSWORD=changeme

# Descuento mínimo para guardar ofertas (30%)
MIN_DISCOUNT=0.30

